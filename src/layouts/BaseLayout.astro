---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '@fontsource/poppins/900.css';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins900 from '@fontsource/poppins/files/poppins-latin-900-normal.woff2?url';
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Only the homepage actually represents the event — other pages (e.g. regulamin) must not carry this schema. */
  includeEventSchema?: boolean;
  socialLinks?: { facebook?: string; instagram?: string };
  /** Cloudflare Web Analytics site token. Loads unconditionally (no cookies/localStorage) — omit to disable. */
  cloudflareToken?: string;
}

const { title, description, ogImage, includeEventSchema = false, socialLinks, cloudflareToken } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const siteRoot = new URL('/', Astro.site ?? Astro.url).href;
const ogImageUrl = ogImage ?? new URL('/logos/og-image.png', Astro.site ?? Astro.url).href;
const logoUrl = new URL('/logos/logo_growup.png', Astro.site ?? Astro.url).href;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Fundacja DeepKind',
  url: siteRoot,
  logo: logoUrl,
  // NIP is Poland's tax ID — taxID is the correct schema.org fit. KRS (the court/company
  // register number) has no dedicated schema.org property, so it goes under identifier.
  taxID: '5214132486',
  identifier: { '@type': 'PropertyValue', propertyID: 'KRS', value: '0001193215' },
  sameAs: [socialLinks?.facebook, socialLinks?.instagram].filter(Boolean),
};
const organizationJsonLdSafe = JSON.stringify(organizationJsonLd).replace(/</g, '\\u003c');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'GrowUp Hackathon 2026',
  description,
  image: ogImageUrl,
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  startDate: '2026-11-12',
  endDate: '2027-01-14',
  location: [
    { '@type': 'VirtualLocation', url: canonical },
    {
      '@type': 'Place',
      name: 'Kraków',
      address: { '@type': 'PostalAddress', addressLocality: 'Kraków', addressCountry: 'PL' },
    },
  ],
  organizer: { '@type': 'Organization', name: 'Fundacja DeepKind', url: canonical },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'PLN',
    url: canonical,
    availability: 'https://schema.org/InStock',
  },
  isAccessibleForFree: true,
};

// Escape `<` so content can never break out of the <script> context (e.g. a literal </script>).
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

const cfBeaconAttr = cloudflareToken ? JSON.stringify({ token: cloudflareToken }) : undefined;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logos/logo_growup.png" />
    <link rel="apple-touch-icon" href="/logos/apple-touch-icon.png" />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins900} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pl_PL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={organizationJsonLdSafe} />
    {includeEventSchema && <script is:inline type="application/ld+json" set:html={jsonLdSafe} />}

    {cfBeaconAttr && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeaconAttr} />
    )}

    <script is:inline>
      // Flag that JS is available so scroll-reveal can safely start hidden.
      // Without this flag the content stays visible (see .reveal in global.css).
      document.documentElement.dataset.js = '';
      // Apply the saved palette-preview theme before first paint (no flash).
      try {
        var t = localStorage.getItem('gh-theme');
        if (t && t !== 'neon') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-nav" href="#main">Przejdź do treści</a>
    {import.meta.env.DEV && <ThemeSwitcher />}
    <slot />

    <script>
      // Reveal sections as they scroll into view; no-op when reduced motion is preferred.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        targets.forEach((el) => observer.observe(el));
        // Failsafe: if the observer never fires (edge cases, JS hang), reveal
        // everything after a short delay so content can never stay hidden.
        window.setTimeout(() => targets.forEach((el) => el.classList.add('is-visible')), 3000);
      }
    </script>

    <script>
      // Count-up numbers when they scroll into view. Non-numeric values (e.g. "Kraków")
      // are left untouched. Reduced-motion users see the final value immediately.
      const reduceCount = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-countup]'));
      type CountData = { target: number; prefix: string; suffix: string };
      const store = new Map<HTMLElement, CountData>();

      for (const el of counters) {
        const full = (el.textContent ?? '').trim();
        const match = full.match(/\d[\d\s.,]*/);
        if (!match || match.index === undefined) continue;
        const target = parseInt(match[0].replace(/[^\d]/g, ''), 10);
        if (Number.isNaN(target)) continue;
        store.set(el, {
          target,
          prefix: full.slice(0, match.index),
          suffix: full.slice(match.index + match[0].length),
        });
        if (!reduceCount) el.textContent = `${full.slice(0, match.index)}0${full.slice(match.index + match[0].length)}`;
      }

      if (!reduceCount && store.size > 0 && 'IntersectionObserver' in window) {
        const run = (el: HTMLElement, data: CountData) => {
          const duration = 1200;
          let start: number | null = null;
          const step = (now: number) => {
            if (start === null) start = now;
            const p = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = `${data.prefix}${Math.round(data.target * eased)}${data.suffix}`;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const data = store.get(entry.target as HTMLElement);
              if (entry.isIntersecting && data) {
                run(entry.target as HTMLElement, data);
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 },
        );
        store.forEach((_, el) => io.observe(el));
      }
    </script>
  </body>
</html>
