---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';
import { Icon } from 'astro-icon/components';

interface Props {
  hero: HomeContent['hero'];
  waitlistUrl: string;
}

const { hero, waitlistUrl } = Astro.props;
---

<section class="hero hero-gradient" aria-labelledby="hero-heading">
  <span class="hero__beam hero__beam--left" aria-hidden="true"></span>
  <span class="hero__beam hero__beam--right" aria-hidden="true"></span>
  <span class="hero__ring hero__ring--1" aria-hidden="true"></span>
  <span class="hero__blob" aria-hidden="true"></span>
  <span class="hero__ring hero__ring--2" aria-hidden="true"></span>

  <div class="hero__panel poster-outline">
    <p class="eyebrow"><span class="accent-dot" aria-hidden="true"></span>{hero.eyebrow}</p>

    <h1 class="hero__wordmark" id="hero-heading">
      <span class="sr-only">{hero.eyebrow} — </span>{hero.wordmarkLead}<span class="text-gradient">{hero.wordmarkAccent}</span>
    </h1>

    <p class="hero__tagline">
      <span class="hero__tagline-purple">{hero.taglinePurple}</span>{' '}
      <span class="hero__tagline-lime">{hero.taglineLime}</span>
    </p>

    <p class="hero__lead">{hero.leadParagraph1}</p>
    {hero.leadParagraph2 && <p class="hero__lead">{hero.leadParagraph2}</p>}

    <div class="hero__actions">
      {
        hero.ctaEnabled ? (
          <a class="btn-gradient btn-gradient--md" href={safeHref(waitlistUrl)} target="_blank" rel="noopener noreferrer">
            {hero.ctaLabel}
            <Icon name="ph:arrow-right-bold" aria-hidden="true" />
          </a>
        ) : (
          <button class="btn-gradient btn-gradient--md" type="button" disabled>
            {hero.ctaLabel}
            <Icon name="ph:arrow-right-bold" aria-hidden="true" />
          </button>
        )
      }
    </div>

    {
      hero.countdownTarget && (
        <div class="hero__countdown" data-countdown={hero.countdownTarget}>
          <div class="hero__count-grid" role="timer" aria-live="off">
            <div class="hero__count">
              <span class="hero__count-num" data-unit="days">--</span>
              <span class="hero__count-label">dni</span>
            </div>
            <div class="hero__count">
              <span class="hero__count-num" data-unit="hours">--</span>
              <span class="hero__count-label">godz.</span>
            </div>
            <div class="hero__count">
              <span class="hero__count-num" data-unit="minutes">--</span>
              <span class="hero__count-label">min</span>
            </div>
            <div class="hero__count">
              <span class="hero__count-num" data-unit="seconds">--</span>
              <span class="hero__count-label">sek.</span>
            </div>
          </div>
          {hero.countdownCaption && <p class="hero__countdown-caption">{hero.countdownCaption}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 9rem var(--space-4) var(--space-16);
  }

  .hero__beam {
    position: absolute;
    width: 44vw;
    height: 120vh;
    pointer-events: none;
    opacity: 0.7;
    filter: saturate(120%);
  }
  .hero__beam--left {
    left: -14vw;
    top: 10vh;
    background: linear-gradient(
      140deg,
      color-mix(in oklch, var(--c-purple-light) 28%, transparent),
      color-mix(in oklch, var(--c-purple-light) 4%, transparent) 35%,
      transparent 35%
    );
    transform: rotate(-8deg);
    clip-path: polygon(0 0, 26% 0, 74% 100%, 48% 100%);
  }
  .hero__beam--right {
    right: -10vw;
    top: -6vh;
    background: linear-gradient(
      140deg,
      color-mix(in oklch, var(--c-violet-500) 32%, transparent),
      color-mix(in oklch, var(--c-violet-500) 4%, transparent) 40%,
      transparent 40%
    );
    transform: rotate(6deg);
    clip-path: polygon(18% 0, 100% 0, 56% 100%, 30% 100%);
  }

  .hero__ring {
    position: absolute;
    border-radius: var(--radius-pill);
    pointer-events: none;
  }
  .hero__ring--1 {
    top: 16%;
    left: 10%;
    width: 14rem;
    height: 14rem;
    border: 1px solid color-mix(in oklch, var(--c-purple-light) 20%, transparent);
  }
  .hero__ring--2 {
    top: 12%;
    right: 12%;
    width: 20rem;
    height: 20rem;
    border: 1px solid color-mix(in oklch, var(--c-violet-500) 20%, transparent);
  }
  .hero__blob {
    position: absolute;
    bottom: 14%;
    right: -4%;
    width: 18rem;
    height: 18rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklch, var(--c-violet-500) 18%, transparent);
    filter: blur(120px);
    pointer-events: none;
  }

  .hero__panel {
    position: relative;
    z-index: 1;
    max-width: 64rem;
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-6) var(--space-12);
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--c-panel-1) 82%, transparent),
      color-mix(in oklch, var(--c-panel-1) 42%, transparent)
    );
    border: 1px solid color-mix(in oklch, var(--c-white) 9%, transparent);
    box-shadow: 0 24px 80px color-mix(in oklch, black 35%, transparent);
    backdrop-filter: blur(12px);
  }

  .hero__wordmark {
    font-size: clamp(3.5rem, 16vw, 10rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--c-white);
    margin-block: var(--space-8) var(--space-5);
  }

  .hero__tagline {
    font-size: clamp(1.25rem, 4vw, 2.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: var(--space-8);
  }
  .hero__tagline-purple {
    color: var(--c-purple-400);
  }
  .hero__tagline-lime {
    color: var(--c-lime-400);
  }

  .hero__lead {
    max-width: 48rem;
    margin-inline: auto;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-slate-300);
  }
  .hero__lead + .hero__lead {
    margin-top: var(--space-6);
  }

  .hero__actions {
    margin-top: var(--space-10);
    display: flex;
    justify-content: center;
  }

  .hero__countdown {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .hero__count-grid {
    display: inline-flex;
    gap: var(--space-2);
  }
  .hero__count {
    min-width: 4.25rem;
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--c-white) 5%, transparent);
    border: 1px solid color-mix(in oklch, var(--c-white) 10%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .hero__count-num {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 900;
    line-height: 1;
    color: var(--c-lime-400);
    font-variant-numeric: tabular-nums;
  }
  .hero__count-label {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-slate-400);
  }
  .hero__countdown-caption {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-gray-300);
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: 9rem;
    }
    .hero__lead {
      font-size: 1.125rem;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.hero__countdown');
  const target = el?.dataset.countdown ? new Date(el.dataset.countdown).getTime() : NaN;

  if (el && !Number.isNaN(target)) {
    const units: Record<string, HTMLElement | null> = {
      days: el.querySelector('[data-unit="days"]'),
      hours: el.querySelector('[data-unit="hours"]'),
      minutes: el.querySelector('[data-unit="minutes"]'),
      seconds: el.querySelector('[data-unit="seconds"]'),
    };
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const total = Math.floor(diff / 1000);
      const days = Math.floor(total / 86400);
      const hours = Math.floor((total % 86400) / 3600);
      const minutes = Math.floor((total % 3600) / 60);
      const seconds = total % 60;
      if (units.days) units.days.textContent = String(days);
      if (units.hours) units.hours.textContent = pad(hours);
      if (units.minutes) units.minutes.textContent = pad(minutes);
      if (units.seconds) units.seconds.textContent = pad(seconds);
      if (diff === 0) clearInterval(timer);
    };

    tick();
    const timer = setInterval(tick, 1000);
  }
</script>
