---
import type { HomeContent } from '../lib/types';

interface Props {
  cookie: HomeContent['cookie'];
  /** Google Analytics Measurement ID (G-XXXXXXXXXX). Empty/undefined keeps analytics fully disabled — see the script below. */
  gaMeasurementId?: string;
}

const { cookie, gaMeasurementId } = Astro.props;
---

<div
  class="cookie-banner"
  id="cookie-banner"
  role="region"
  aria-label="Informacja o plikach cookies"
  data-ga-id={gaMeasurementId}
  hidden
>
  <p class="cookie-banner__text">{cookie.text}</p>
  <div class="cookie-banner__actions">
    <button type="button" class="cookie-banner__decline" id="cookie-decline">{cookie.decline}</button>
    <button type="button" class="cookie-banner__accept" id="cookie-accept">{cookie.accept}</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
    font-size: 0.9375rem;
    width: min(92vw, 64rem);
    color: var(--c-gray-300);
    background: color-mix(in oklch, var(--c-cookie) 96%, transparent);
    border: 1px solid color-mix(in oklch, var(--c-lime-500) 35%, transparent);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    box-shadow: 0 -12px 32px color-mix(in oklch, var(--c-ink-deep) 55%, transparent);
    backdrop-filter: blur(20px);
  }
  .cookie-banner[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cookie-banner {
      transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
    }
    @starting-style {
      .cookie-banner:not([hidden]) {
        opacity: 0;
        transform: translateX(-50%) translateY(1.5rem);
      }
    }
  }
  .cookie-banner__text {
    flex: 1 1 auto;
    min-width: 0;
    text-align: center;
  }
  .cookie-banner__actions {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-3);
  }
  .cookie-banner__accept,
  .cookie-banner__decline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-pill);
    transition: background 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .cookie-banner__decline {
    border: 0;
    color: var(--c-text-100);
    background: var(--c-gray-700);
  }
  .cookie-banner__decline:hover {
    background: var(--c-gray-500);
  }
  .cookie-banner__accept {
    border: 0;
    color: var(--c-ink-deep);
    background: var(--c-lime-500);
  }
  .cookie-banner__accept:hover {
    background: var(--c-lime-400);
  }

  @media (max-width: 767px) {
    .cookie-banner {
      width: calc(100vw - 1rem);
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
      font-size: 0.8125rem;
    }
  }

  @media (min-width: 768px) {
    .cookie-banner {
      flex-direction: row;
    }
    .cookie-banner__text {
      text-align: left;
    }
  }
</style>

<style is:global>
  body {
    transition: padding-bottom 0.25s var(--ease-out);
  }
</style>

<script>
  declare global {
    interface Window {
      dataLayer: unknown[];
    }
  }

  const STORAGE_KEY = 'growup-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const decline = document.getElementById('cookie-decline');

  function loadAnalytics(measurementId: string): void {
    if (window.location.hostname !== 'growuphackathon.pl') return;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer ?? [];
    function gtag(..._args: unknown[]) {
      window.dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', measurementId);
  }

  if (banner && accept && decline) {
    let consent: string | null = null;
    try {
      consent = localStorage.getItem(STORAGE_KEY);
    } catch {
      consent = null;
    }

    const gaId = banner.dataset.gaId;
    if (consent === 'accepted' && gaId) {
      loadAnalytics(gaId);
    }

    if (consent !== 'accepted' && consent !== 'declined') {
      setTimeout(() => {
        banner.hidden = false;
        const reserveSpace = () => {
          const occluded = window.innerHeight - banner.getBoundingClientRect().top;
          document.body.style.paddingBottom = `${occluded}px`;
        };
        reserveSpace();
        new ResizeObserver(reserveSpace).observe(banner);
      }, 400);
    }

    const dismiss = (value: 'accepted' | 'declined') => {
      banner.hidden = true;
      document.body.style.paddingBottom = '';
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch {
        /* empty */
      }
    };

    accept.addEventListener('click', () => {
      dismiss('accepted');
      if (gaId) loadAnalytics(gaId);
    });

    decline.addEventListener('click', () => {
      dismiss('declined');
    });
  }
</script>
